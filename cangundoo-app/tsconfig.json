{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["./app/*"],
      "@features/*": ["./features/*"],
      "@components/*": ["./components/*"],
      "@services/*": ["./services/*"],
      "@store/*": ["./store/*"],
      "@lib/*": ["./lib/*"],
      "@types/*": ["./types/*"],
      "@supabase/*": ["./supabase/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
